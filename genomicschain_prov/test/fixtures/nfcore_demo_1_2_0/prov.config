// U0 — provenance bundle capture for nf-core/demo (GenomicsChain service 2.5, design v0.1 §9 U0).
// Passed with `-c /tmp/gc_u0_demo/prov.config`; the pipeline's own config is merged underneath.
plugins {
  id 'nf-prov'
}

prov {
  enabled = true
  formats {
    bco   { file = 'bco.json';              overwrite = true }
    wrroc { file = 'ro-crate-metadata.json'; overwrite = true }
  }
}
