    "record_type",
    "record_version",
    "mcp_tool_name",
    "mcp_tool_version",
    "subject_ref",
    "prov_proof_ref",
    "bundle_digest",
    "reachability_rule",
    "scope",
    "observation_nonce",
    "observer",
    "observed_at",
    "checker",
    "same_signer",
    "counts",
    "backing",
    "not_checked",
    "submission_key",
    "operator"
  ],
