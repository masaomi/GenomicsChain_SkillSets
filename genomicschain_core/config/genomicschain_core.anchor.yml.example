# Anchor deployment profile. Copy to genomicschain_core.yml on the ONE node that
# signs and records.
#
# Turning this on registers gc_tier1_submit and gc_tier2_submit. That node then
# needs an MMP identity with a signing key; without one the submit path fails
# closed rather than recording an unattributable proof.
#
# Proofs are append-only. A misconfigured second anchor cannot be un-recorded.
genomicschain:
  anchor_profile: true
